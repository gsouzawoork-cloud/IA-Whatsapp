# =============================================================================
# IA WhatsApp — variáveis de ambiente (EXEMPLO)
# =============================================================================
#
# Este arquivo documenta as variáveis de ambiente PREVISTAS para fases futuras.
# NENHUMA integração usa estas variáveis nesta fase (fundação).
#
# REGRAS:
#   - NUNCA versione um arquivo .env com valores reais. Apenas este .env.example.
#   - NUNCA exponha segredos ao navegador. Somente variáveis prefixadas com
#     NEXT_PUBLIC_ são enviadas ao cliente — jamais coloque segredos nelas.
#   - Copie para `.env.local` (ignorado pelo git) e preencha localmente quando
#     a fase correspondente for implementada.
#
# Todas as chaves abaixo estão VAZIAS de propósito.
# -----------------------------------------------------------------------------

# --- Aplicação (público) -----------------------------------------------------
# URL pública da aplicação. Seguro para o navegador.
NEXT_PUBLIC_APP_URL=

# --- Banco de dados / Supabase (Fase 2) --------------------------------------
# URL do projeto Supabase. Público (usado pelo cliente).
NEXT_PUBLIC_SUPABASE_URL=
# Chave anônima do Supabase. Público (protegida por Row Level Security).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de service role. SEGREDO — apenas no servidor. NUNCA no navegador.
SUPABASE_SERVICE_ROLE_KEY=
# String de conexão direta ao PostgreSQL. SEGREDO — apenas no servidor.
DATABASE_URL=

# --- IA / Claude API (Fase 4) ------------------------------------------------
# Chave da Claude API. SEGREDO — apenas no servidor.
ANTHROPIC_API_KEY=

# --- WhatsApp Cloud API (Fase 5) ---------------------------------------------
# Token de acesso da WhatsApp Cloud API. SEGREDO — apenas no servidor.
WHATSAPP_ACCESS_TOKEN=
# Identificador do número de telefone. Apenas no servidor.
WHATSAPP_PHONE_NUMBER_ID=
# Token de verificação do webhook. SEGREDO — apenas no servidor.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Segredo para validar a assinatura dos webhooks. SEGREDO — apenas no servidor.
WHATSAPP_APP_SECRET=

# --- Pagamentos (Fase 6) -----------------------------------------------------
# Credenciais do provedor de pagamentos. SEGREDO — apenas no servidor.
PAYMENTS_PROVIDER_API_KEY=
# Segredo para validar webhooks de pagamento. SEGREDO — apenas no servidor.
PAYMENTS_WEBHOOK_SECRET=
